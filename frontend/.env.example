# MCP Server Configuration
VITE_MCP_DEFAULT_HOST=localhost
VITE_MCP_DEFAULT_PORT=8000

# Default LLM provider (ollama | gemini | openrouter | openai-compatible)
VITE_LLM_DEFAULT_PROVIDER=
# Defaults for the OpenAI-compatible provider (e.g. a vLLM endpoint)
VITE_OPENAI_COMPATIBLE_DEFAULT_BASE_URL=
VITE_OPENAI_COMPATIBLE_DEFAULT_MODEL=

# LLM API keys are entered at runtime via the settings dialog
# (stored in browser IndexedDB) — never at build time.
